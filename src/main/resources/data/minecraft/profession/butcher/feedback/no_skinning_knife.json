{
  "schema": "townstead:profession_feedback_rule/v1",
  "mods": "butchery",
  "trigger": "periodic",
  "priority": 90,
  "when": {
    "type": "pheno:and",
    "conditions": [
      {
        "type": "townstead:worksite",
        "scope": "profession",
        "buildings": ["compat/butchery/butcher_shop_l*"],
        "block_condition": {
          "type": "pheno:and",
          "conditions": [
            { "type": "pheno:in_tag", "tag": "butchery:drained_carcass" },
            { "type": "pheno:block_state", "property": "blockstate", "value": "2" }
          ]
        }
      },
      {
        "type": "pheno:inventory",
        "item_condition": {
          "type": "pheno:ingredient",
          "tag": "townstead:butcher_skinning_knives"
        },
        "inverted": true
      }
    ]
  },
  "dialogue": {
    "translate": "dialogue.chat.butcher_request.no_skinning_knife"
  },
  "variants": 3
}
