{
  "schema": "townstead:hangout_activity/v2",
  "mods": "herbalbrews",
  "kind": "drink",
  "minimum_participants": 2,
  "maximum_participants": 4,
  "duration_ticks": 600,
  "roles": {
    "host": 1,
    "guest": 3
  },
  "postures": [
    "townstead:sit"
  ],
  "start_when": {
    "type": "pheno:thirst",
    "max": 15
  },
  "service": {
    "courses": [
      {
        "id": "tea_service",
        "kind": "drink",
        "role": "barista",
        "at_ticks": 160,
        "lease_ticks": 100
      }
    ]
  },
  "on_service_accepted": {
    "type": "pheno:performance",
    "performance": "townstead:tea_pour",
    "channel": "hospitality",
    "duration_ticks": 70,
    "priority": 20,
    "fallback": "vanilla_gesture"
  },
  "performance": {
    "id": "townstead:quiet_tea",
    "channel": "social",
    "duration_ticks": 600,
    "priority": 10,
    "fallback": "stand"
  },
  "social_cues": {
    "conversations": true,
    "dialogue_interval_ticks": 240
  }
}
