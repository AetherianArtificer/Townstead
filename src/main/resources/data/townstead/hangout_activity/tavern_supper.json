{
  "schema": "townstead:hangout_activity/v1",
  "kind": "mixed",
  "minimum_participants": 2,
  "maximum_participants": 5,
  "duration_ticks": 480,
  "roles": { "server": 1, "patron": 4 },
  "postures": ["townstead:sit"],
  "start_when": {
    "type": "pheno:or",
    "conditions": [
      { "type": "pheno:hunger", "max": 74 },
      { "type": "pheno:thirst", "max": 15 }
    ]
  },
  "service_when": { "type": "pheno:state", "state": "townstead_state:drunk", "min_tier": "wasted", "inverted": true },
  "service": { "courses": [
    { "id": "table_drinks", "kind": "drink", "role": "server", "at_ticks": 120, "lease_ticks": 100 },
    { "id": "supper", "kind": "eat", "role": "server", "at_ticks": 260, "lease_ticks": 100 }
  ] },
  "on_service_refused": [
    { "type": "pheno:speak", "pool": "dialogue.chat.townstead_drunk.service_refused", "variants": 4 },
    { "type": "pheno:performance", "performance": "townstead:kind_refusal", "channel": "hospitality", "duration_ticks": 60, "priority": 60, "fallback": "stand" }
  ],
  "performance": { "id": "townstead:supper_conversation", "channel": "social", "duration_ticks": 480, "priority": 15, "fallback": "vanilla_gesture" }
}
