{
  "schema": "townstead:profession_path/v1",
  "mods": "chefsdelight",
  "name": {
    "translate": "career.townstead.cook.path.chef"
  },
  "title": {
    "translate": "career.townstead.cook.title.chef"
  },
  "color": "#C95F3B",
  "worksites": [
    "farmersdelight:cooking_pot",
    "farmersdelight:skillet",
    "farmersdelight:stove",
    "farmersdelight:cutting_board"
  ],
  "powers": [
    {
      "type": "pheno:action_over_time",
      "interval": 20,
      "resource_cost": {
        "resource": "townstead:flow",
        "amount": 0
      },
      "condition": {
        "type": "pheno:and",
        "conditions": [
          {
            "type": "pheno:career_xp",
            "career": "townstead:cook",
            "at_least": 300
          },
          {
            "type": "pheno:and",
            "conditions": [
              {
                "type": "pheno:building",
                "building_prefix": "compat/farmersdelight/kitchen_l"
              },
              {
                "type": "pheno:block_in_radius",
                "radius": 8,
                "block_condition": {
                  "type": "pheno:and",
                  "conditions": [
                    {
                      "type": "pheno:in_tag",
                      "tag": "townstead:kitchen/heat_sources"
                    },
                    {
                      "type": "pheno:block_state",
                      "property": "lit",
                      "value": "true",
                      "if_missing": "pass"
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "action": {
        "type": "pheno:change_resource",
        "resource": "townstead:flow",
        "amount": 3
      }
    },
    {
      "type": "pheno:trigger",
      "trigger": "when_work",
      "verbs": [
        "townstead_work:cook",
        "townstead_work:chop"
      ],
      "condition": {
        "type": "pheno:and",
        "conditions": [
          {
            "type": "pheno:career_xp",
            "career": "townstead:cook",
            "at_least": 300
          },
          {
            "type": "pheno:not",
            "condition": {
              "type": "pheno:skill",
              "skill": "townstead:cook/chef/chef_de_cuisine"
            }
          }
        ]
      },
      "action": {
        "type": "pheno:change_resource",
        "resource": "townstead:flow",
        "amount": 10
      }
    }
  ],
  "skills": [
    [
      "plating",
      "pass",
      "chefs_knife"
    ],
    [
      "honed_edge",
      "hands",
      "julienne"
    ],
    [
      "running_the_pass",
      "expedite",
      "hot_pan"
    ],
    [
      "family_meal",
      "all_day",
      "sizzle"
    ],
    [
      "in_the_weeds",
      "chef_de_cuisine",
      "dinner_rush"
    ]
  ]
