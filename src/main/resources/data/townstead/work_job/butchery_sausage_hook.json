                "conditions": [
                  { "type": "pheno:block", "block": "butchery:cooked_blood_sausages" },
                  {
                    "type": "pheno:or",
                    "conditions": [
                      { "type": "pheno:block_state", "property": "blockstate", "value": "0" },
                      { "type": "pheno:block_state", "property": "blockstate", "value": "1" }
                    ]
                  }
