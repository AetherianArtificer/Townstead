{
  "schema": "townstead:workstation/v2",
  "mods": ["kaleidoscope_cookery"],
  "blocks": ["kaleidoscope_cookery:pot"],
  "shift_end": "finish",
  "supplies": ["#kaleidoscope_cookery:oil"],
  "requires": {
    "type": "pheno:offset", "y": -1,
    "condition": {
      "type": "pheno:and",
      "conditions": [
        { "type": "pheno:in_tag", "tag": "townstead:kitchen/heat_sources" },
        { "type": "pheno:block_state", "property": "lit", "value": "true", "if_missing": "pass" }
      ]
    }
  },
  "ready": {
    "type": "pheno:or",
    "conditions": [
      { "type": "pheno:block_entity", "property": "status", "value": 2 },
      { "type": "pheno:block_entity", "property": "status", "value": 3 }
    ]
  },
  "behavior": [
    {
      "type": "pheno:offset", "y": -1,
      "block_action": {
        "type": "pheno:use_block", "item": "supply",
        "supply": "#kaleidoscope_cookery:lit_stove",
        "condition": { "type": "pheno:block_state", "property": "lit", "value": "false" }
      }
    },
    {
      "type": "pheno:use_block", "item": "supply", "supply": "#kaleidoscope_cookery:oil",
      "condition": { "type": "pheno:block_state", "property": "has_oil", "value": "false" }
    },
    { "type": "pheno:use_block", "item": "ingredient", "all": true },
    { "type": "pheno:use_block", "item": "tool", "tool": "#kaleidoscope_cookery:kitchen_shovel" }
  ],
  "collect": [
    { "type": "pheno:use_block", "item": "container" },
    {
      "type": "pheno:use_block", "item": "tool",
      "tool": "#kaleidoscope_cookery:kitchen_shovel",
      "secondary_use": true,
      "condition": {
        "type": "pheno:or",
        "conditions": [
          { "type": "pheno:block_entity", "property": "status", "value": 2 },
          { "type": "pheno:block_entity", "property": "status", "value": 3 }
        ]
      }
    }
  ]
}
