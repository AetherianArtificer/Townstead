{
  "schema": "townstead:relationship_descriptor/v1",
  "display": { "translate": "relationship_descriptor.townstead.estranged_beloved" },
  "priority": 100,
  "tags": ["estranged", "attached"],
  "when": {
    "type": "pheno:and",
    "conditions": [
      { "type": "pheno:value", "value": { "type": "pheno:relationship", "quality": "townstead:affection" }, "comparison": ">=", "compare_to": 25 },
      { "type": "pheno:value", "value": { "type": "pheno:relationship", "quality": "townstead:trust" }, "comparison": "<=", "compare_to": -25 },
      { "type": "pheno:value", "value": { "type": "pheno:relationship", "quality": "townstead:resentment" }, "comparison": ">=", "compare_to": 20 }
    ]
  }
}
