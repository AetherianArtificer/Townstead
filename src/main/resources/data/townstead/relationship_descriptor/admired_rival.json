{
  "schema": "townstead:relationship_descriptor/v1",
  "display": { "translate": "relationship_descriptor.townstead.admired_rival" },
  "priority": 80,
  "tags": ["admired_rival", "rival"],
  "when": {
    "type": "pheno:and",
    "conditions": [
      { "type": "pheno:value", "value": { "type": "pheno:relationship", "quality": "townstead:affection" }, "comparison": "<=", "compare_to": -10 },
      { "type": "pheno:value", "value": { "type": "pheno:relationship", "quality": "townstead:respect" }, "comparison": ">=", "compare_to": 25 }
    ]
  }
}
