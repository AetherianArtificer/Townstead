{
  "schema": "townstead:consumable/v2",
  "mods": ["vinery"],
  "items": ["#vinery:red_wine", "#vinery:white_wine"],
  "effects": {
    "type": "pheno:add_state",
    "state": "townstead_state:drunk",
    "amount": 20,
    "duration": 6000,
    "source": "vinery:wine"
  },
  "transaction": {
    "mode": "replace_with_pheno",
    "accounting": "consume_one",
    "consumers": ["villager"],
    "servings": 1,
    "remainder": {
      "mode": "item",
      "item": "vinery:wine_bottle",
      "destination": "storage"
    },
    "effect_admission": {
      "default": "deny"
    }
  }
}
