{
  "schema": "townstead:consumable/v2",
  "mods": ["brewery"],
  "items": ["#townstead:compat/brewery/drinks"],
  "requires": {
    "type": "pheno:or",
    "conditions": [
      { "type": "pheno:life_stage", "stage": "adult" },
      {
        "type": "pheno:and",
        "conditions": [
          { "type": "pheno:life_stage", "stage": "teen" },
          {
            "type": "pheno:config",
            "scope": "server",
            "file": "townstead-server.toml",
            "path": ["needs", "teensMayDrinkAlcohol"],
            "equals": true,
            "default": false
          }
        ]
      }
    ]
  },
  "effects": {
    "type": "pheno:add_state",
    "state": "townstead_state:drunk",
    "amount": 20,
    "duration": 6000,
    "source": "brewery:drink"
  },
  "transaction": {
    "mode": "replace_with_pheno",
    "accounting": "consume_one",
    "consumers": ["villager"],
    "servings": 1,
    "remainder": {
      "mode": "item",
      "item": "brewery:beer_mug",
      "destination": "source"
    },
    "effect_admission": {
      "default": "deny"
    }
  }
}
